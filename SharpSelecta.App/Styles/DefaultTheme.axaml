<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:styles="using:SharpSelecta.App.Styles">

    <!-- FluentTheme's own Button template paints its disabled/pointerover backgrounds on an
         internal part that a plain Setter override can't reach, so this toolbar variant gets its
         own minimal template instead of fighting it. -->
    <Style Selector="Button.toolbar-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.toolbar-button-hover:not(:disabled):pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.ToolbarHover}" />
    </Style>
    <Style Selector="Button.toolbar-button-hover:not(:disabled):pressed">
        <Setter Property="Background" Value="{DynamicResource Brush.ToolbarPressed}" />
    </Style>

    <!-- The template above has no disabled state of its own, so text content (e.g. "View ▾") needs
         dimming here; icon buttons are handled by the Svg rule below. -->
    <Style Selector="Button.toolbar-button:disabled TextBlock">
        <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled}" />
    </Style>

    <!-- CurrentColor must be set here, not as an inline attribute on each Svg - a locally set
         value always beats a Style, so the :disabled override below would never apply. -->
    <Style Selector="svg|Svg.toolbar-icon">
        <Setter Property="svg:Svg.CurrentColor" Value="{DynamicResource Color.IconForeground}" />
    </Style>
    <Style Selector="Button.toolbar-button:disabled svg|Svg.toolbar-icon">
        <Setter Property="svg:Svg.CurrentColor" Value="{DynamicResource Color.IconDisabled}" />
    </Style>

    <!-- Text roles. Views pick a role with Classes="..." instead of setting Opacity/FontSize/
         FontWeight/Foreground themselves, so every value comes from the tokens in ThemeMetrics/
         ThemeColors and a custom theme can change a role by overriding the token. -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Opacity" Value="{DynamicResource Opacity.TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.tertiary">
        <Setter Property="Opacity" Value="{DynamicResource Opacity.TextTertiary}" />
    </Style>
    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
    </Style>
    <Style Selector="TextBlock.strong">
        <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Strong}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
    </Style>
    <Style Selector="TextBlock.field-label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="{DynamicResource Opacity.TextSecondary}" />
    </Style>

    <!-- Labels of the read-only file info (Duration, Bitrate, ...): extra room before their value. -->
    <Style Selector="TextBlock.info-label">
        <Setter Property="Margin" Value="{styles:Spacing Right=M}" />
    </Style>

    <!-- A text box whose content failed validation. -->
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
    </Style>

    <!-- A row for something that isn't there (e.g. a playlist entry whose file is gone). -->
    <Style Selector="DataGridRow.missing">
        <Setter Property="Opacity" Value="{DynamicResource Opacity.Missing}" />
    </Style>

    <!-- FluentTheme's TextBox paints its pointerover/focus border and background straight onto an
         internal template part (PART_BorderElement) via these resource keys, bypassing the
         TextBox's own BorderBrush/Background properties entirely - overriding those properties
         from outside has no effect, so the resources themselves are neutralized here instead. -->
    <Styles.Resources>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver">Transparent</SolidColorBrush>
        <SolidColorBrush x:Key="TextControlBackgroundFocused">Transparent</SolidColorBrush>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
    </Styles.Resources>

</Styles>
