<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SharpSelecta.App.App"
             xmlns:local="using:SharpSelecta.App"
             RequestedThemeVariant="Dark">
             <!-- Dark is the app's default theme. "Default" follows the system theme variant instead; -->
             <!-- the user's saved preference (Interface settings) is re-applied at startup in App.axaml.cs. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SharpSelecta.App/Styles/ThemeColors.axaml" />
                <ResourceInclude Source="avares://SharpSelecta.App/Styles/ThemeMetrics.axaml" />
                <ResourceInclude Source="avares://SharpSelecta.App/Styles/Spacing.axaml" />
                <ResourceInclude Source="avares://SharpSelecta.App/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://SharpSelecta.App/Styles/DefaultTheme.axaml" />
    </Application.Styles>
</Application>