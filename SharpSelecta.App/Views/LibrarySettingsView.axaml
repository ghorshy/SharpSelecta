<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:styles="using:SharpSelecta.App.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="SharpSelecta.App.Views.LibrarySettingsView"
             x:DataType="vm:LibraryViewModel">

    <StackPanel Classes="settings-page">
        <StackPanel Classes="settings-section">
            <TextBlock Text="{x:Static res:Strings.SettingsSectionFolders}" Classes="settings-heading" />
            <ItemsControl ItemsSource="{Binding Folders.PendingPaths}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto" Margin="{styles:Spacing Bottom=XXS}">
                            <TextBlock Grid.Column="0" Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Remove}" Click="OnRemoveFolderClick" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Static res:Strings.NoLibraryFoldersAdded}" IsVisible="{Binding !Folders.HasPendingFolders}" />
            <Button Content="{x:Static res:Strings.ChooseLibraryFolder}" Command="{Binding Folders.AddPendingFolderCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}" Classes="error" TextWrapping="Wrap" IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <StackPanel Classes="settings-field">
                <CheckBox Content="{x:Static res:Strings.WatchLibraryFolders}" IsChecked="{Binding WatchFolders}" />
                <TextBlock Text="{x:Static res:Strings.WatchLibraryFoldersHint}" Classes="settings-hint indented" />
            </StackPanel>
        </StackPanel>

        <StackPanel Classes="settings-section">
            <TextBlock Text="{x:Static res:Strings.SettingsSectionMaintenance}" Classes="settings-heading" />
            <Button Content="{x:Static res:Strings.ClearArtworkCache}" Command="{Binding Grid.ClearArtworkCacheCommand}" HorizontalAlignment="Left" />
            <Button Content="{x:Static res:Strings.FindInconsistentCompilationFlags}" Click="OnFindInconsistentCompilationFlagsClick" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
</UserControl>
