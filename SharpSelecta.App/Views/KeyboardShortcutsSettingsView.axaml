<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:styles="using:SharpSelecta.App.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="280"
             x:Class="SharpSelecta.App.Views.KeyboardShortcutsSettingsView"
             x:DataType="vm:KeyboardShortcutsViewModel">

    <StackPanel>
        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Classes="settings-page" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutSectionViewModel">
                    <StackPanel Classes="settings-section">
                        <TextBlock Text="{Binding Title}" Classes="settings-heading" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                                    <StackPanel Margin="{styles:Spacing Bottom=XS}">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ScopeLabel}" Classes="secondary small" TextWrapping="Wrap"
                                                           IsVisible="{Binding ScopeLabel, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding DisplayGesture}" Click="OnRecordClick" Margin="{styles:Spacing Left=XS}" Width="{DynamicResource Size.Settings.ShortcutButtonWidth}" HorizontalContentAlignment="Center" />
                                            <Button Grid.Column="2" Content="{x:Static res:Strings.Reset}" Click="OnResetClick" Margin="{styles:Spacing Left=XXS}" />
                                            <Button Grid.Column="3" Content="{x:Static res:Strings.Clear}" Click="OnClearClick" Margin="{styles:Spacing Left=XXS}" />
                                        </Grid>
                                        <TextBlock Text="{Binding ConflictWarning}" Classes="error" TextWrapping="Wrap"
                                                   IsVisible="{Binding ConflictWarning, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>

</UserControl>
