<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:styles="using:SharpSelecta.App.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="SharpSelecta.App.Views.IntegrationsSettingsView"
             x:DataType="vm:IntegrationsSettingsViewModel">

    <StackPanel Spacing="{styles:SpacingValue XXS}">
        <CheckBox Content="{x:Static res:Strings.DiscordPresenceToggle}" IsChecked="{Binding DiscordPresenceEnabled}" />
        <TextBlock Text="{x:Static res:Strings.DiscordPresenceHint}" Classes="tertiary small" TextWrapping="Wrap"
                   Margin="{styles:Spacing Left=L}" />
    </StackPanel>

</UserControl>
