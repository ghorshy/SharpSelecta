<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SharpSelecta.App.ViewModels"
        xmlns:views="using:SharpSelecta.App.Views"
        xmlns:styles="using:SharpSelecta.App.Styles"
        xmlns:res="using:SharpSelecta.App.Resources"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="SharpSelecta.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/sharpselecta.ico"
        Title="SharpSelecta"
        Width="{DynamicResource Size.MainWindow.Width}"
        Height="{DynamicResource Size.MainWindow.Height}">

    <!-- KeyBindings are rebindable, so they're built at runtime from ShortcutRegistry in MainWindow.axaml.cs. -->

    <DockPanel Margin="{styles:Spacing Uniform=M}" LastChildFill="True">
        <!-- Shown once an update has downloaded (Windows installer only). -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding Updates.ShowUpdateBar}"
                Margin="{styles:Spacing Bottom=M}" Padding="{styles:Spacing Uniform=S}"
                CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Brush.Surface}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{styles:SpacingValue S}">
                <TextBlock Grid.Column="0" Text="{Binding Updates.UpdateReadyMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="{x:Static res:Strings.RestartToUpdate}" Command="{Binding Updates.RestartToUpdateCommand}" />
                <Button Grid.Column="2" Content="{x:Static res:Strings.UpdateLater}" Command="{Binding Updates.DismissUpdateBarCommand}" />
            </Grid>
        </Border>

        <views:PlaybackControlsView DockPanel.Dock="Bottom" Margin="{styles:Spacing Top=M}" DataContext="{Binding PlaybackControls}" />

        <!-- Side panel | splitter | library | splitter | side panel: the panel takes the outer column on its
             side (Settings → Interface), the other one and its splitter collapse to nothing. -->
        <Grid>
            <Grid.Styles>
                <Style Selector="GridSplitter.side-panel">
                    <Setter Property="Width" Value="{DynamicResource Size.Splitter.Width}" />
                    <Setter Property="ResizeDirection" Value="Columns" />
                    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Border.now-playing">
                    <Setter Property="Margin" Value="{styles:Spacing Top=M}" />
                </Style>
                <Style Selector="Border.now-playing.above-queue">
                    <Setter Property="Margin" Value="{styles:Spacing Bottom=M}" />
                </Style>
            </Grid.Styles>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidePanel.LeftWidth, Mode=TwoWay}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding SidePanel.RightWidth, Mode=TwoWay}" />
            </Grid.ColumnDefinitions>

            <views:LibraryView Grid.Column="2" DataContext="{Binding Library}" />

            <GridSplitter Grid.Column="1" Classes="side-panel" IsVisible="{Binding SidePanel.IsOnLeft}"
                          DragCompleted="OnSplitterDragCompleted" />
            <GridSplitter Grid.Column="3" Classes="side-panel" IsVisible="{Binding SidePanel.IsOnRight}"
                          DragCompleted="OnSplitterDragCompleted" />

            <DockPanel Grid.Column="{Binding SidePanel.Column}" IsVisible="{Binding SidePanel.IsVisible}" LastChildFill="True">
                <!-- The wrapper carries the layout bindings: on NowPlayingView itself they would resolve
                     against its own DataContext (PlaybackControls). -->
                <Border Classes="now-playing"
                        Classes.above-queue="{Binding SidePanel.IsQueueAtBottom}"
                        Classes.hide-artwork="{Binding !SidePanel.ShowsArtwork}"
                        Classes.hide-details="{Binding !SidePanel.ShowsDetails}"
                        DockPanel.Dock="{Binding SidePanel.NowPlayingDock}"
                        IsVisible="{Binding SidePanel.ShowsNowPlaying}">
                    <views:NowPlayingView DataContext="{Binding PlaybackControls}" />
                </Border>
                <views:QueueView DataContext="{Binding Queue}" />
            </DockPanel>
        </Grid>
    </DockPanel>

</Window>