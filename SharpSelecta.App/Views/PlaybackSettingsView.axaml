<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:styles="using:SharpSelecta.App.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="SharpSelecta.App.Views.PlaybackSettingsView"
             x:DataType="vm:PlaybackSettingsViewModel">

    <StackPanel Classes="settings-page">
        <StackPanel Classes="settings-section">
            <TextBlock Text="{x:Static res:Strings.SettingsSectionStartup}" Classes="settings-heading" />
            <CheckBox Content="{x:Static res:Strings.RestoreQueueOnStartup}" IsChecked="{Binding RestoreQueueOnStartup}" />
            <CheckBox Content="{x:Static res:Strings.ResumePlaybackOnLaunch}" IsChecked="{Binding ResumePlaybackOnLaunch}"
                      IsEnabled="{Binding RestoreQueueOnStartup}" Classes="indented" />
        </StackPanel>

        <StackPanel Classes="settings-section">
            <TextBlock Text="{x:Static res:Strings.SettingsSectionPlayingTracks}" Classes="settings-heading" />
            <StackPanel Classes="settings-field">
                <TextBlock Text="{x:Static res:Strings.TrackStartActionLabel}" Classes="settings-label" />
                <ComboBox ItemsSource="{Binding TrackStartActionOptions}" SelectedItem="{Binding SelectedTrackStartActionOption}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackStartActionOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Classes="settings-field">
                <TextBlock Text="{x:Static res:Strings.OpenedFilesActionLabel}" Classes="settings-label" />
                <ComboBox ItemsSource="{Binding OpenedFilesActionOptions}" SelectedItem="{Binding SelectedOpenedFilesActionOption}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:OpenedFilesActionOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <StackPanel Classes="settings-section">
            <TextBlock Text="{x:Static res:Strings.SettingsSectionOutput}" Classes="settings-heading" />
            <StackPanel Classes="settings-field">
                <TextBlock Text="{x:Static res:Strings.OutputDevice}" Classes="settings-label" />
                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:OutputDeviceOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <CheckBox Content="{x:Static res:Strings.PauseOnDeviceDisconnect}" IsChecked="{Binding PauseOnDeviceDisconnect}" />
        </StackPanel>

        <StackPanel Classes="settings-section">
            <TextBlock Text="{x:Static res:Strings.SettingsSectionVolume}" Classes="settings-heading" />
            <StackPanel Classes="settings-field">
                <TextBlock Text="{x:Static res:Strings.VolumeNormalizationLabel}" Classes="settings-label" />
                <ComboBox ItemsSource="{Binding VolumeNormalizationOptions}" SelectedItem="{Binding SelectedVolumeNormalizationOption}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VolumeNormalizationOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{x:Static res:Strings.VolumeNormalizationHint}" Classes="settings-hint" />
            </StackPanel>
            <StackPanel Classes="settings-field" IsEnabled="{Binding IsUntaggedGainEditable}">
                <TextBlock Text="{x:Static res:Strings.UntaggedGainLabel}" Classes="settings-label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{styles:SpacingValue S}">
                    <Slider Minimum="-12" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding UntaggedGainDb}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding UntaggedGainText}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
            <CheckBox Content="{x:Static res:Strings.UseLogarithmicVolumeScale}" IsChecked="{Binding UseLogarithmicVolumeScale}" />
        </StackPanel>

        <StackPanel Classes="settings-section">
            <TextBlock Text="{x:Static res:Strings.SettingsSectionSeeking}" Classes="settings-heading" />
            <CheckBox Content="{x:Static res:Strings.UseWaveformSlider}" IsChecked="{Binding UseWaveformSlider}" />
            <StackPanel Classes="settings-field">
                <TextBlock Text="{x:Static res:Strings.SeekStepSeconds}" Classes="settings-label" />
                <NumericUpDown Value="{Binding SeekStepSeconds}" Minimum="1" Maximum="10" Increment="1"
                               FormatString="0" HorizontalAlignment="Left" Width="{DynamicResource Size.Settings.NumberFieldWidth}" />
            </StackPanel>
            <StackPanel Classes="settings-field">
                <TextBlock Text="{x:Static res:Strings.PreviousRestartThresholdSeconds}" Classes="settings-label" />
                <NumericUpDown Value="{Binding PreviousRestartThresholdSeconds}" Minimum="0" Maximum="30" Increment="1"
                               FormatString="0" HorizontalAlignment="Left" Width="{DynamicResource Size.Settings.NumberFieldWidth}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
