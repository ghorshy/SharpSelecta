<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:styles="using:SharpSelecta.App.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="SharpSelecta.App.Views.PlaybackSettingsView"
             x:DataType="vm:PlaybackSettingsViewModel">

    <StackPanel Spacing="{styles:SpacingValue S}">
        <CheckBox Content="{x:Static res:Strings.RestoreQueueOnStartup}" IsChecked="{Binding RestoreQueueOnStartup}" />

        <StackPanel Spacing="{styles:SpacingValue XXS}" Margin="{styles:Spacing Top=S}">
            <TextBlock Text="{x:Static res:Strings.TrackStartActionLabel}" Classes="secondary" />
            <ComboBox ItemsSource="{Binding TrackStartActionOptions}"
                      SelectedItem="{Binding SelectedTrackStartActionOption}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackStartActionOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="{styles:SpacingValue XXS}" Margin="{styles:Spacing Top=S}">
            <TextBlock Text="{x:Static res:Strings.OpenedFilesActionLabel}" Classes="secondary" />
            <ComboBox ItemsSource="{Binding OpenedFilesActionOptions}"
                      SelectedItem="{Binding SelectedOpenedFilesActionOption}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpenedFilesActionOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="{styles:SpacingValue XXS}" Margin="{styles:Spacing Top=S}">
            <TextBlock Text="{x:Static res:Strings.OutputDevice}" Classes="secondary" />
            <ComboBox ItemsSource="{Binding OutputDevices}"
                      SelectedItem="{Binding SelectedOutputDevice}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutputDeviceOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="{styles:SpacingValue XXS}" Margin="{styles:Spacing Top=S}">
            <TextBlock Text="{x:Static res:Strings.VolumeNormalizationLabel}" Classes="secondary" />
            <ComboBox ItemsSource="{Binding VolumeNormalizationOptions}"
                      SelectedItem="{Binding SelectedVolumeNormalizationOption}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VolumeNormalizationOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{x:Static res:Strings.VolumeNormalizationHint}" Classes="tertiary small" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="{styles:SpacingValue XXS}" Margin="{styles:Spacing Top=S}" IsEnabled="{Binding IsUntaggedGainEditable}">
            <TextBlock Text="{x:Static res:Strings.UntaggedGainLabel}" Classes="secondary" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{styles:SpacingValue S}">
                <Slider Minimum="-12" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding UntaggedGainDb}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding UntaggedGainText}" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <CheckBox Content="{x:Static res:Strings.UseLogarithmicVolumeScale}"
                  IsChecked="{Binding UseLogarithmicVolumeScale}"
                  Margin="{styles:Spacing Top=S}" />

        <CheckBox Content="{x:Static res:Strings.UseWaveformSlider}" IsChecked="{Binding UseWaveformSlider}"
                  Margin="{styles:Spacing Top=S}" />

        <StackPanel Spacing="{styles:SpacingValue XXS}" Margin="{styles:Spacing Top=S}">
            <TextBlock Text="{x:Static res:Strings.SeekStepSeconds}" Classes="secondary" />
            <NumericUpDown Value="{Binding SeekStepSeconds}" Minimum="1" Maximum="10" Increment="1"
                            FormatString="0" HorizontalAlignment="Left" Width="{DynamicResource Size.Settings.NumberFieldWidth}" />
        </StackPanel>
    </StackPanel>

</UserControl>
