<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SharpSelecta.App.ViewModels"
        xmlns:res="using:SharpSelecta.App.Resources"
        xmlns:converters="using:SharpSelecta.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
        x:Class="SharpSelecta.App.Views.AlbumCoverWindow"
        x:DataType="vm:IArtworkPreview"
        Title="{x:Static res:Strings.AlbumCoverWindowTitle}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource Brush.CoverWindowBackground}">
        <Image x:Name="Cover" Source="{Binding ArtworkBytes, Converter={x:Static converters:ArtworkConverter.Instance}}" />
    </Border>

</Window>
