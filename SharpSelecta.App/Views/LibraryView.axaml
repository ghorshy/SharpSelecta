<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:core="using:SharpSelecta.Core.Library"
             xmlns:views="using:SharpSelecta.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:converters="using:SharpSelecta.App.Converters"
             xmlns:styles="using:SharpSelecta.App.Styles"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="SharpSelecta.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Styles>
        <Style Selector="Button.toolbar-button.active">
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="{styles:Spacing Bottom=XS}" IsVisible="{Binding HasTracks}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="{styles:SpacingValue M}">
                <views:ViewModeSwitcher SelectedMode="{Binding ActiveViewMode, Mode=TwoWay}"
                                        IsEnabled="{Binding LibrarySection, Converter={x:Static conv:ObjectConverters.NotEqual}, ConverterParameter={x:Static core:LibrarySection.Playlist}}" />

                <Button Classes="toolbar-button toolbar-button-hover"
                        Content="{x:Static res:Strings.NavLibrary}"
                        Command="{Binding SetLibrarySectionCommand}"
                        CommandParameter="{x:Static core:LibrarySection.Library}"
                        Classes.active="{Binding LibrarySection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static core:LibrarySection.Library}}" />

                <Button Classes="toolbar-button toolbar-button-hover"
                        Content="{x:Static res:Strings.NavRecentlyAdded}"
                        Command="{Binding SetLibrarySectionCommand}"
                        CommandParameter="{x:Static core:LibrarySection.RecentlyAdded}"
                        Classes.active="{Binding LibrarySection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static core:LibrarySection.RecentlyAdded}}" />

                <Button Classes="toolbar-button toolbar-button-hover"
                        Content="{x:Static res:Strings.Playlists}"
                        Classes.active="{Binding LibrarySection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static core:LibrarySection.Playlist}}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnPlaylistsFlyoutOpening">
                            <MenuItem Header="{x:Static res:Strings.NewPlaylistEllipsis}" Click="OnNewPlaylistClick" />
                            <Separator IsVisible="{Binding Playlists.Playlists.Count, Converter={x:Static converters:IntToBoolConverter.Instance}}" />
                            <!-- Playlist entries are built imperatively in OnPlaylistsFlyoutOpening: MenuItem.ItemsSource
                                 turns a MenuItem into a nested submenu rather than flat siblings in this flyout. -->
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Border DockPanel.Dock="Right" BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                    Padding="{styles:Spacing Left=XS, Right=XS}">
                <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                    <svg:Svg Grid.Column="0" Classes="toolbar-icon" Width="14" Height="14"
                             Path="{DynamicResource Icon.Search}" Margin="{styles:Spacing Right=XXS}" />
                    <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchQuery, Mode=TwoWay}"
                             PlaceholderText="{x:Static res:Strings.Search}" BorderThickness="0" Background="Transparent"
                             MinWidth="160" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="toolbar-button toolbar-button-hover" Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding SearchQuery, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                        <svg:Svg Classes="toolbar-icon" Width="12" Height="12" Path="{DynamicResource Icon.X}" />
                    </Button>
                </Grid>
            </Border>
        </DockPanel>

    <Grid>
        <!-- Empty state: no library folder chosen (or remembered) yet — the button takes center
             stage as an invitation, instead of sitting small at the top above an empty list.
             Gated on ShowEmptyState (NoTracks AND NOT loading), not NoTracks alone, so this
             doesn't flash up misleadingly while a remembered folder is still being (re)scanned. -->
        <StackPanel IsVisible="{Binding ShowEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{styles:SpacingValue M}">
            <Button Content="{x:Static res:Strings.ChooseLibraryFolder}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="OrangeRed" TextWrapping="Wrap" HorizontalAlignment="Center" IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsLoadingLibrary}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{styles:SpacingValue M}">
            <ProgressBar IsIndeterminate="True" Width="200" />
            <TextBlock Text="{x:Static res:Strings.LoadingLibrary}" HorizontalAlignment="Center" />
        </StackPanel>

        <Border IsVisible="{Binding IsAlbumGridViewVisible}">
            <views:AlbumGridView DataContext="{Binding Grid}" />
        </Border>

        <Border IsVisible="{Binding IsRecentlyAddedCoverArtVisible}">
            <views:AlbumGridView DataContext="{Binding RecentlyAddedGrid}" />
        </Border>

        <views:TrackListView IsVisible="{Binding IsTrackListViewVisible}"
                              ItemsSource="{Binding DisplayedTracks}"
                              AllowReorderAndSort="True" />

        <views:TrackListView IsVisible="{Binding IsRecentlyAddedListVisible}"
                              ItemsSource="{Binding RecentlyAddedTracks}"
                              AllowReorderAndSort="False" />

        <views:TrackListView IsVisible="{Binding IsPlaylistViewVisible}"
                              ItemsSource="{Binding Playlists.Tracks}"
                              AllowReorderAndSort="False"
                              AllowRowReorder="True" />

    </Grid>
    </DockPanel>

</UserControl>
