<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:views="using:SharpSelecta.App.Views"
             xmlns:converters="using:SharpSelecta.App.Converters"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:styles="using:SharpSelecta.App.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="400"
             x:Class="SharpSelecta.App.Views.QueueView"
             x:DataType="vm:QueueViewModel">

    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="{styles:Spacing Bottom=M}">
            <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Queue}" Classes="strong" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="toolbar-button toolbar-button-hover" Classes.active="{Binding IsAutoDjEnabled}"
                    Content="{x:Static res:Strings.AutoDj}" ToolTip.Tip="{x:Static res:Strings.AutoDjTooltip}"
                    Command="{Binding ToggleAutoDjCommand}" />
            <Button Grid.Column="2" Classes="toolbar-button toolbar-button-hover" Content="{x:Static res:Strings.Clear}"
                    Command="{Binding ClearQueueCommand}" />
        </Grid>

        <!-- Drag-and-drop reordering: a press only turns into a drag once the pointer actually
             moves past a small threshold (see code-behind) — DragDrop.AllowDrop here is what lets
             this ListBox accept the drop. -->
        <ListBox x:Name="QueueList"
                 ItemsSource="{Binding Entries}"
                 SelectedIndex="{Binding CurrentIndex, Mode=OneWay}"
                 DoubleTapped="OnEntryDoubleTapped"
                 DragDrop.AllowDrop="True">
            <ListBox.Styles>
                <!-- Right-click on an entry: Play Now / Remove from Queue. -->
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu x:DataType="vm:QueueEntryViewModel">
                                <MenuItem Header="{x:Static res:Strings.PlayNow}"
                                          Command="{Binding Queue.PlayEntryCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="{x:Static res:Strings.RemoveFromQueue}"
                                          Command="{Binding Queue.RemoveFromQueueCommand}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="{x:Static res:Strings.Properties}"
                                          Click="OnPropertiesClick" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Tracks Auto DJ queued are dimmed so they read as suggestions next to the ones queued by hand. -->
                <Style Selector="StackPanel.auto-dj">
                    <Setter Property="Opacity" Value="{DynamicResource Opacity.TextSecondary}" />
                </Style>

                <!-- The row currently being dragged fades out a bit... -->
                <Style Selector="ListBoxItem.dragging">
                    <Setter Property="Opacity" Value="{DynamicResource Opacity.Dragging}" />
                </Style>

                <!-- ...and a line above whatever row is under the cursor shows where it will land. -->
                <Style Selector="ListBoxItem.drag-over">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="BorderThickness" Value="{DynamicResource Border.Top.Thick}" />
                </Style>

                <!-- Dragging past the last row (or into the empty space below the list) still
                     drops at the end of the queue — show the line below the last row instead. -->
                <Style Selector="ListBoxItem.drag-over-end">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="BorderThickness" Value="{DynamicResource Border.Bottom.Thick}" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QueueEntryViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="{styles:Spacing Uniform=S}">
                        <Border Grid.Column="0" Width="{DynamicResource Size.Queue.Thumbnail}" Height="{DynamicResource Size.Queue.Thumbnail}" VerticalAlignment="Center" Background="{DynamicResource Brush.ThumbnailPlaceholder}">
                            <Panel>
                                <Image Source="{Binding ArtworkBytes, Converter={x:Static converters:ArtworkConverter.Instance}}"
                                       IsVisible="{Binding ArtworkBytes, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                       Stretch="UniformToFill" />
                                <views:AlbumCoverPlaceholderIcon IsVisible="{Binding ArtworkBytes, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="{styles:Spacing Left=S, Right=XXS}" VerticalAlignment="Center"
                                    Classes.auto-dj="{Binding IsAutoDj}">
                            <TextBlock Text="{Binding Title}" Classes="strong" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" Classes="secondary small" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Playing}"
                                   VerticalAlignment="Center" Margin="{styles:Spacing Left=XXS}"
                                   IsVisible="{Binding IsCurrent}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>
