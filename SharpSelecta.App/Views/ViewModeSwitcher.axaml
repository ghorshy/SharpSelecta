<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:styles="using:SharpSelecta.App.Styles"
             x:Class="SharpSelecta.App.Views.ViewModeSwitcher">
    <Button Classes="toolbar-button toolbar-button-hover">
        <StackPanel Orientation="Horizontal" Spacing="{styles:SpacingValue S}">
            <TextBlock Text="{x:Static res:Strings.View}" VerticalAlignment="Center" />
            <TextBlock Text="▾" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
            <MenuFlyout>
                <MenuItem Header="{x:Static res:Strings.ViewModeList}" Click="OnListClicked" />
                <MenuItem Header="{x:Static res:Strings.ViewModeCoverArt}" Click="OnCoverArtClicked" />
            </MenuFlyout>
        </Button.Flyout>
    </Button>
</UserControl>
