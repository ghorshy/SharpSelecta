<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SharpSelecta.App.ViewModels"
        xmlns:res="using:SharpSelecta.App.Resources"
        xmlns:styles="using:SharpSelecta.App.Styles"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="320"
        x:Class="SharpSelecta.App.Views.EqualizerWindow"
        x:DataType="vm:EqualizerViewModel"
        Title="{x:Static res:Strings.Equalizer}"
        Width="{DynamicResource Size.Equalizer.Width}"
        Height="{DynamicResource Size.Equalizer.Height}"
        CanResize="False">

    <StackPanel Spacing="{styles:SpacingValue M}" Margin="{styles:Spacing Uniform=M}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{styles:SpacingValue S}">
            <CheckBox Grid.Column="0" Content="{x:Static res:Strings.EqualizerEnabled}" IsChecked="{Binding Enabled}" />
            <TextBlock Grid.Column="2" Text="{x:Static res:Strings.EqualizerPreset}" VerticalAlignment="Center" Classes="secondary" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPresetName}" Width="{DynamicResource Size.Equalizer.PresetWidth}" />
        </Grid>

        <ItemsControl x:Name="BandsPanel" ItemsSource="{Binding Bands}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EqualizerBandViewModel">
                    <StackPanel Spacing="{styles:SpacingValue XXS}" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding GainDbLabel}" HorizontalAlignment="Center" Classes="small" />
                        <Slider Orientation="Vertical" Height="{DynamicResource Size.Equalizer.SliderHeight}" Minimum="-12" Maximum="12"
                                Value="{Binding GainDb}" />
                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Classes="secondary small" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>

</Window>
