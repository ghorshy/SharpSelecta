<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:views="using:SharpSelecta.App.Views"
             xmlns:converters="using:SharpSelecta.App.Converters"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:styles="using:SharpSelecta.App.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="260"
             x:Class="SharpSelecta.App.Views.NowPlayingView"
             x:DataType="vm:PlaybackControlsViewModel">

    <!-- Settings → Interface can hide either part; the main window sets these classes on an ancestor. -->
    <UserControl.Styles>
        <Style Selector="Panel#Artwork">
            <Setter Property="Margin" Value="{styles:Spacing Top=S}" />
        </Style>
        <Style Selector=".hide-details Panel#Artwork">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector=".hide-artwork Panel#Artwork">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=".hide-details StackPanel#Details">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="{styles:SpacingValue XS}" IsVisible="{Binding CurrentTrack, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
        <StackPanel x:Name="Details" Spacing="{styles:SpacingValue XS}">
            <TextBlock Text="{Binding CurrentTrack.Title}" Classes="strong" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CurrentTrack.Artist, Converter={x:Static converters:ArtistsDisplayConverter.Instance}}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CurrentTrack.Album}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CurrentTrack.Year}" />
            <TextBlock Text="{Binding CurrentTrackTechnicalSummary}" Classes="secondary small" TextWrapping="Wrap" />
        </StackPanel>
        <!-- Double-tap opens the cover at its real resolution in its own window (AlbumCoverWindow) -
             only meaningful when there's actual artwork, hence the guard in the handler rather than
             gating this Panel's own visibility. -->
        <Panel x:Name="Artwork" DoubleTapped="OnArtworkDoubleTapped">
            <Image Source="{Binding CurrentTrackArtworkBytes, Converter={x:Static converters:ArtworkConverter.Instance}}"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   IsVisible="{Binding CurrentTrackArtworkBytes, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <views:AlbumCoverPlaceholderIcon HorizontalAlignment="Stretch"
                                             IsVisible="{Binding CurrentTrackArtworkBytes, Converter={x:Static conv:ObjectConverters.IsNull}}" />
        </Panel>
    </StackPanel>

</UserControl>
