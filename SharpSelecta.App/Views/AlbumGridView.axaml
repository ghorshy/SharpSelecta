<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:views="using:SharpSelecta.App.Views"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:core="using:SharpSelecta.Core.Library"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:converters="using:SharpSelecta.App.Converters"
             xmlns:styles="using:SharpSelecta.App.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="SharpSelecta.App.Views.AlbumGridView"
             x:Name="Root"
             x:DataType="vm:AlbumGridViewModel">

    <UserControl.Styles>
        <!-- Tiles/close button are plain Buttons used as clickable containers, not as buttons in
             the usual sense - strip the default chrome so they look like the tile/icon they wrap. -->
        <Style Selector="Button.plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.plain:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.album-tracks">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.album-tracks ListBoxItem">
            <Setter Property="Padding" Value="{styles:Spacing Left=XS, Right=XS, Top=XXS, Bottom=XXS}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="{styles:Spacing Uniform=XS}">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{styles:SpacingValue XS}" IsVisible="{Binding AllowUserSort}">
                <Button Classes="toolbar-button toolbar-button-hover">
                    <StackPanel Orientation="Horizontal" Spacing="{styles:SpacingValue XXS}">
                        <TextBlock Text="{x:Static res:Strings.SortBy}" Classes="secondary" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SortModeLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="▾" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{x:Static res:Strings.ColumnTitle}" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static core:AlbumSortMode.Title}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnArtist}" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static core:AlbumSortMode.Artist}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnYear}" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static core:AlbumSortMode.Year}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Classes="toolbar-button toolbar-button-hover" Content="{Binding SortDirectionSymbol}" Command="{Binding ToggleSortDirectionCommand}" />
            </StackPanel>

            <Slider Grid.Column="1"
                    Minimum="{DynamicResource Size.Album.TileMin}" Maximum="{DynamicResource Size.Album.TileMax}"
                    Value="{Binding TileSize, Mode=TwoWay}"
                    Width="{DynamicResource Size.Album.TileSliderWidth}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer x:Name="Scroller" SizeChanged="OnScrollerSizeChanged">
            <!-- ItemsRepeater instead of ItemsControl for the row list specifically: it virtualizes
                 inside a ScrollViewer (only on-screen rows get realized), unlike ItemsControl which
                 builds every row's - and every tile's - whole visual tree upfront regardless of
                 scroll position. A large library (hundreds of albums) made that the dominant cost
                 in both memory and CPU. Each row's own tile strip stays a plain ItemsControl since
                 a single row only ever has a handful of tiles (whatever the column count is). -->
            <ItemsRepeater ItemsSource="{Binding Rows}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumRowViewModel">
                        <StackPanel Margin="{styles:Spacing Bottom=L}">
                            <ItemsControl ItemsSource="{Binding Tiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="{styles:SpacingValue L}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlbumViewModel">
                                        <!-- Border, not Button: Button's own pointer-press handling (tracking press
                                             state for its Click event) marks PointerPressed handled before a plain
                                             XAML-attached PointerPressed handler on the same element ever runs, so
                                             OnTilePointerPressed silently never fired. Border has no competing click
                                             machinery, so the handler gets every press. Background="Transparent" makes
                                             the whole tile (not just its Image/text children) hit-test-visible. -->
                                        <Border Background="Transparent"
                                                Width="{Binding #Root.DataContext.TileSize}"
                                                Tapped="OnTileTapped"
                                                DoubleTapped="OnTileDoubleTapped">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{x:Static res:Strings.PlayNow}"
                                                              Command="{Binding Library.PlayAlbumNowCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{x:Static res:Strings.PlayNext}"
                                                              Command="{Binding Library.PlayAlbumNextCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{x:Static res:Strings.AddToQueue}"
                                                              Command="{Binding Library.AddAlbumToQueueCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{x:Static res:Strings.AddToPlaylist}"
                                                              SubmenuOpened="OnAlbumAddToPlaylistSubmenuOpened">
                                                        <MenuItem Header="{x:Static res:Strings.NewPlaylistEllipsis}" />
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding Library.ShowInFileManagerLabel}"
                                                              Command="{Binding Library.ShowAlbumInFileManagerCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="{x:Static res:Strings.Properties}"
                                                              Click="OnAlbumPropertiesClick" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel Spacing="{styles:SpacingValue XXS}">
                                                <Border Width="{Binding #Root.DataContext.TileSize}"
                                                        Height="{Binding #Root.DataContext.TileSize}"
                                                        ClipToBounds="True"
                                                        CornerRadius="{DynamicResource Radius.Control}"
                                                        Background="{DynamicResource Brush.Surface}">
                                                    <Panel>
                                                        <Image Source="{Binding ArtworkBytes, Converter={x:Static converters:ArtworkConverter.Instance}}"
                                                               IsVisible="{Binding ArtworkBytes, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                               Stretch="UniformToFill" />
                                                        <views:AlbumCoverPlaceholderIcon IsVisible="{Binding ArtworkBytes, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                                                    </Panel>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Classes="strong" TextTrimming="CharacterEllipsis"
                                                           Width="{Binding #Root.DataContext.TileSize}" />
                                                <TextBlock Text="{Binding Artist}" Classes="secondary" TextTrimming="CharacterEllipsis"
                                                           Width="{Binding #Root.DataContext.TileSize}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border IsVisible="{Binding ExpandedAlbum, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                    Background="{DynamicResource Brush.Surface}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="{styles:Spacing Uniform=S}"
                                    Margin="{styles:Spacing Top=XS}">
                                <!-- ContentControl rather than DataContext="{Binding ExpandedAlbum}" directly on a
                                     static Grid: the latter briefly left children bound against the outer
                                     AlbumRowViewModel context (and vice versa) during ItemsRepeater container
                                     recycling, logging "unable to resolve" binding warnings - ContentControl owns
                                     that content-swap lifecycle instead of relying on ad-hoc DataContext timing. -->
                                <ContentControl Content="{Binding ExpandedAlbum}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:AlbumViewModel">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <DockPanel Grid.Column="0">
                                                    <Button DockPanel.Dock="Top" Classes="plain" HorizontalAlignment="Right"
                                                            Content="&#x2715;"
                                                            Command="{Binding #Root.DataContext.ToggleExpandCommand}"
                                                            CommandParameter="{Binding}" />

                                                    <!-- ListBox rather than ItemsControl for the theme's hover/selected row
                                                         highlight, same as the Queue - otherwise rows don't look clickable. -->
                                                    <ListBox ItemsSource="{Binding TrackRows}" Classes="album-tracks"
                                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AlbumTrackRowViewModel">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" DoubleTapped="OnExpandedTrackDoubleTapped"
                                                                      Background="Transparent">
                                                                    <Grid.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="{x:Static res:Strings.PlayNow}"
                                                                                      Command="{Binding Track.Library.PlayNowCommand}"
                                                                                      CommandParameter="{Binding Track.Track}" />
                                                                            <MenuItem Header="{x:Static res:Strings.PlayNext}"
                                                                                      Command="{Binding Track.Library.PlayNextCommand}"
                                                                                      CommandParameter="{Binding Track.Track}" />
                                                                            <MenuItem Header="{x:Static res:Strings.AddToQueue}"
                                                                                      Command="{Binding Track.Library.AddToQueueCommand}"
                                                                                      CommandParameter="{Binding Track.Track}" />
                                                                            <MenuItem Header="{x:Static res:Strings.AddToPlaylist}"
                                                                                      SubmenuOpened="OnTrackAddToPlaylistSubmenuOpened">
                                                                                <MenuItem Header="{x:Static res:Strings.NewPlaylistEllipsis}" />
                                                                            </MenuItem>
                                                                            <MenuItem Header="{Binding Track.Library.ShowInFileManagerLabel}"
                                                                                      Command="{Binding Track.Library.ShowInFileManagerCommand}"
                                                                                      CommandParameter="{Binding Track.Track}" />
                                                                            <Separator />
                                                                            <MenuItem Header="{x:Static res:Strings.Properties}"
                                                                                      Click="OnTrackPropertiesClick" />
                                                                        </ContextMenu>
                                                                    </Grid.ContextMenu>
                                                                    <TextBlock Grid.Column="0" Text="{Binding TrackNumber}" Width="{DynamicResource Size.Album.TrackNumberWidth}" Classes="secondary" />
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{styles:SpacingValue XXS}">
                                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding ArtistSuffix}" Classes="tertiary" TextTrimming="CharacterEllipsis"
                                                                                   IsVisible="{Binding ArtistSuffix, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding LengthDisplay}" Classes="secondary" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </DockPanel>

                                                <Panel Grid.Column="1" Width="{DynamicResource Size.Album.ExpandedCover}" Height="{DynamicResource Size.Album.ExpandedCover}" Margin="{styles:Spacing Left=S}"
                                                       DoubleTapped="OnExpandedArtworkDoubleTapped">
                                                    <Image Source="{Binding ArtworkBytes, Converter={x:Static converters:ArtworkConverter.Instance}}"
                                                           IsVisible="{Binding ArtworkBytes, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                           Stretch="UniformToFill" />
                                                    <views:AlbumCoverPlaceholderIcon IsVisible="{Binding ArtworkBytes, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </DockPanel>

</UserControl>
