<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SharpSelecta.App.ViewModels"
        xmlns:res="using:SharpSelecta.App.Resources"
        xmlns:styles="using:SharpSelecta.App.Styles"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="420"
        x:Class="SharpSelecta.App.Views.CreditsEditorWindow"
        x:DataType="vm:CreditsEditorViewModel"
        Title="{x:Static res:Strings.CreditsEditorTitle}"
        Width="{DynamicResource Size.CreditsEditor.Width}"
        Height="{DynamicResource Size.CreditsEditor.Height}"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- The row being dragged fades, and a line above or below the row under the cursor (by which half
             it is over) shows where it lands. -->
        <Style Selector="Border.credit-row.dragging">
            <Setter Property="Opacity" Value="{DynamicResource Opacity.Dragging}" />
        </Style>
        <Style Selector="Border.credit-row.drag-over">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Border.Top.Thick}" />
        </Style>
        <Style Selector="Border.credit-row.drag-over-below">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="{DynamicResource Border.Bottom.Thick}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto,Auto" Margin="{styles:Spacing Uniform=M}" RowSpacing="{styles:SpacingValue M}">
        <ScrollViewer Grid.Row="0">
            <ItemsControl ItemsSource="{Binding Credits}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CreditEntryViewModel">
                        <Border Classes="credit-row" Margin="{styles:Spacing Bottom=S}"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="OnRowDragOver" DragDrop.DragLeave="OnRowDragLeave" DragDrop.Drop="OnRowDrop">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{styles:SpacingValue S}">
                            <!-- Grab here to reorder. -->
                            <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" VerticalAlignment="Center"
                                    PointerPressed="OnGripPressed">
                                <svg:Svg Classes="toolbar-icon" Width="{DynamicResource Size.Icon.S}" Height="{DynamicResource Size.Icon.S}"
                                         Path="{DynamicResource Icon.GripVertical}" />
                            </Border>
                            <TextBox Grid.Column="1" Text="{Binding Name}" />
                            <ComboBox Grid.Column="2" Width="{DynamicResource Size.CreditsEditor.RoleWidth}"
                                      ItemsSource="{Binding $parent[ItemsControl].((vm:CreditsEditorViewModel)DataContext).Roles}"
                                      SelectedItem="{Binding Role}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RoleOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="3" Content="{x:Static res:Strings.Remove}"
                                    Command="{Binding $parent[ItemsControl].((vm:CreditsEditorViewModel)DataContext).RemoveCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{styles:SpacingValue S}">
            <TextBox Grid.Column="0" Text="{Binding NewCreditName}"
                     PlaceholderText="{x:Static res:Strings.CreditsEditorNewPlaceholder}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <ComboBox Grid.Column="1" Width="{DynamicResource Size.CreditsEditor.RoleWidth}"
                      ItemsSource="{Binding Roles}" SelectedItem="{Binding NewCreditRole}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoleOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Content="{x:Static res:Strings.Add}" Command="{Binding AddCommand}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{styles:SpacingValue S}">
            <Button Content="{x:Static res:Strings.Ok}" Command="{Binding OkCommand}" />
            <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
