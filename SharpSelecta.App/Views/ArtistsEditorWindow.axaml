<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SharpSelecta.App.ViewModels"
        xmlns:res="using:SharpSelecta.App.Resources"
        xmlns:styles="using:SharpSelecta.App.Styles"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="420"
        x:Class="SharpSelecta.App.Views.ArtistsEditorWindow"
        x:DataType="vm:ArtistsEditorViewModel"
        Title="{x:Static res:Strings.ArtistsEditorTitle}"
        Width="{DynamicResource Size.ArtistsEditor.Width}"
        Height="{DynamicResource Size.ArtistsEditor.Height}"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto,Auto" Margin="{styles:Spacing Uniform=M}" RowSpacing="{styles:SpacingValue M}">
        <ScrollViewer Grid.Row="0">
            <ItemsControl ItemsSource="{Binding Artists}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArtistEntryViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{styles:SpacingValue S}"
                              Margin="{styles:Spacing Bottom=S}">
                            <TextBox Grid.Column="0" Text="{Binding Name}" />
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Remove}"
                                    Command="{Binding $parent[ItemsControl].((vm:ArtistsEditorViewModel)DataContext).RemoveCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{styles:SpacingValue S}">
            <TextBox Grid.Column="0" Text="{Binding NewArtistName}"
                     PlaceholderText="{x:Static res:Strings.ArtistsEditorNewPlaceholder}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Content="{x:Static res:Strings.Add}" Command="{Binding AddCommand}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{styles:SpacingValue S}">
            <Button Content="{x:Static res:Strings.Ok}" Command="{Binding OkCommand}" />
            <Button Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
