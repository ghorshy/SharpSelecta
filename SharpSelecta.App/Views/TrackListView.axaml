<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SharpSelecta.App.ViewModels"
             xmlns:res="using:SharpSelecta.App.Resources"
             xmlns:core="using:SharpSelecta.Core.Library"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:converters="using:SharpSelecta.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="SharpSelecta.App.Views.TrackListView"
             x:Name="Root"
             x:DataType="vm:LibraryViewModel">

    <DataGrid x:Name="TracksGrid"
              ItemsSource="{Binding #Root.ItemsSource}"
              AutoGenerateColumns="False"
              CanUserSortColumns="{Binding #Root.AllowReorderAndSort}"
              CanUserResizeColumns="True"
              CanUserReorderColumns="{Binding #Root.AllowReorderAndSort}"
              IsReadOnly="True"
              GridLinesVisibility="Horizontal"
              DoubleTapped="OnTrackDoubleTapped"
              LoadingRow="OnLoadingRow"
              ColumnReordered="OnColumnReordered">
        <!-- No built-in default — without this, dragging a column header to reorder it
             shows no indicator of where it will land. Height is fixed rather than clipped
             to the header row automatically, so it's sized to match it explicitly. -->
        <DataGrid.DropLocationIndicatorTemplate>
            <Template>
                <Border Width="{DynamicResource Size.TrackList.DropIndicatorWidth}" Height="{DynamicResource Size.TrackList.DropIndicatorHeight}" Background="{DynamicResource Brush.Accent}" />
            </Template>
        </DataGrid.DropLocationIndicatorTemplate>

        <DataGrid.Styles>
            <!-- DataGrid's bundled theme uses its own larger default instead of the rest
                 of the app's Fluent-theme content font size — match it explicitly. -->
            <Style Selector="DataGridCell">
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Content}" />
            </Style>

            <!-- Rows are IsReadOnly, so the per-cell "current cell" indicator the bundled
                 theme draws on click doesn't serve editing focus — just row selection,
                 which the row highlight already shows. It's an inner Rectangle in
                 DataGridCell's own control template (not bound to the cell's own
                 BorderBrush/BorderThickness), toggled visible via these pseudo-classes. -->
            <Style Selector="DataGridCell:current /template/ Rectangle">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="DataGridCell:focus /template/ Rectangle">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="DataGridCell:focus-visible /template/ Rectangle">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <!-- Right-click on a column header: choose which columns are visible. -->
            <Style Selector="DataGridColumnHeader">
                <Setter Property="FontSize" Value="{DynamicResource FontSize.Content}" />
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu>
                            <ContextMenu.Styles>
                                <Style Selector="MenuItem">
                                    <Setter Property="StaysOpenOnClick" Value="True" />
                                </Style>
                            </ContextMenu.Styles>
                            <MenuItem Header="{x:Static res:Strings.ColumnTrack}" ToggleType="CheckBox" IsChecked="{Binding IsTrackNumberColumnVisible, Mode=TwoWay}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnTitle}" ToggleType="CheckBox" IsChecked="{Binding IsTitleColumnVisible, Mode=TwoWay}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnArtist}" ToggleType="CheckBox" IsChecked="{Binding IsArtistColumnVisible, Mode=TwoWay}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnAlbum}" ToggleType="CheckBox" IsChecked="{Binding IsAlbumColumnVisible, Mode=TwoWay}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnLength}" ToggleType="CheckBox" IsChecked="{Binding IsLengthColumnVisible, Mode=TwoWay}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnSampleRate}" ToggleType="CheckBox" IsChecked="{Binding IsSampleRateColumnVisible, Mode=TwoWay}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnBitDepth}" ToggleType="CheckBox" IsChecked="{Binding IsBitDepthColumnVisible, Mode=TwoWay}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnBitrate}" ToggleType="CheckBox" IsChecked="{Binding IsBitrateColumnVisible, Mode=TwoWay}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnFileType}" ToggleType="CheckBox" IsChecked="{Binding IsFileTypeColumnVisible, Mode=TwoWay}" />
                            <MenuItem Header="{x:Static res:Strings.ColumnYear}" ToggleType="CheckBox" IsChecked="{Binding IsYearColumnVisible, Mode=TwoWay}" />
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Right-click on a row: same Play Now/Play Next/Add to Queue actions as
                 before, now on DataGridRow instead of ListBoxItem. -->
            <Style Selector="DataGridRow" x:DataType="vm:LibraryTrackViewModel">
                <!-- A missing-file placeholder row (see PlaylistsViewModel.MissingTrackPlaceholder) gets
                     the "missing" class in OnLoadingRow and renders grayed out - only "Remove from
                     playlist" stays fully actionable. -->
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu x:DataType="vm:LibraryTrackViewModel">
                            <MenuItem Header="{x:Static res:Strings.PlayNow}"
                                      Command="{Binding Library.PlayTrackItemCommand}"
                                      CommandParameter="{Binding}"
                                      IsEnabled="{Binding !IsMissing}" />
                            <MenuItem Header="{x:Static res:Strings.PlayNext}"
                                      Command="{Binding Library.PlayNextCommand}"
                                      CommandParameter="{Binding Track}"
                                      IsEnabled="{Binding !IsMissing}" />
                            <MenuItem Header="{x:Static res:Strings.AddToQueue}"
                                      Command="{Binding Library.AddToQueueCommand}"
                                      CommandParameter="{Binding Track}"
                                      IsEnabled="{Binding !IsMissing}" />
                            <MenuItem Header="{x:Static res:Strings.AddToPlaylist}"
                                      IsEnabled="{Binding !IsMissing}"
                                      SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                                <MenuItem.Items>
                                    <MenuItem Header="{x:Static res:Strings.NewPlaylistEllipsis}" />
                                </MenuItem.Items>
                            </MenuItem>
                            <MenuItem Header="{x:Static res:Strings.RemoveFromPlaylist}"
                                      Command="{Binding Library.RemoveFromPlaylistCommand}"
                                      CommandParameter="{Binding Track}"
                                      IsVisible="{Binding Library.LibrarySection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static core:LibrarySection.Playlist}}" />
                            <MenuItem Header="{Binding Library.ShowInFileManagerLabel}"
                                      Command="{Binding Library.ShowInFileManagerCommand}"
                                      CommandParameter="{Binding Track}"
                                      IsEnabled="{Binding !IsMissing}" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Strings.Properties}"
                                      Click="OnPropertiesClick"
                                      IsEnabled="{Binding !IsMissing}" />
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>
        </DataGrid.Styles>

        <DataGrid.Columns>
            <DataGridTextColumn Tag="TrackNumber" Header="{x:Static res:Strings.ColumnTrack}" Binding="{Binding Track.TrackNumber}" IsVisible="{Binding IsTrackNumberColumnVisible}" />
            <DataGridTextColumn Tag="Title" Header="{x:Static res:Strings.ColumnTitle}" Binding="{Binding Track.Title}" IsVisible="{Binding IsTitleColumnVisible}" />
            <DataGridTextColumn Tag="Artist" Header="{x:Static res:Strings.ColumnArtist}" Binding="{Binding Track.Artist, Converter={x:Static converters:ArtistsDisplayConverter.Instance}}" IsVisible="{Binding IsArtistColumnVisible}" />
            <DataGridTextColumn Tag="Album" Header="{x:Static res:Strings.ColumnAlbum}" Binding="{Binding Track.Album}" IsVisible="{Binding IsAlbumColumnVisible}" />
            <DataGridTextColumn Tag="Length" Header="{x:Static res:Strings.ColumnLength}" Binding="{Binding LengthDisplay}" SortMemberPath="Track.Duration" IsVisible="{Binding IsLengthColumnVisible}" />
            <DataGridTextColumn Tag="SampleRate" Header="{x:Static res:Strings.ColumnSampleRate}" Binding="{Binding SampleRateDisplay}" SortMemberPath="Track.SampleRate" IsVisible="{Binding IsSampleRateColumnVisible}" />
            <DataGridTextColumn Tag="BitDepth" Header="{x:Static res:Strings.ColumnBitDepth}" Binding="{Binding BitDepthDisplay}" SortMemberPath="Track.BitDepth" IsVisible="{Binding IsBitDepthColumnVisible}" />
            <DataGridTextColumn Tag="Bitrate" Header="{x:Static res:Strings.ColumnBitrate}" Binding="{Binding BitrateDisplay}" SortMemberPath="Track.Bitrate" IsVisible="{Binding IsBitrateColumnVisible}" />
            <DataGridTextColumn Tag="FileType" Header="{x:Static res:Strings.ColumnFileType}" Binding="{Binding Track.FileType}" IsVisible="{Binding IsFileTypeColumnVisible}" />
            <DataGridTextColumn Tag="Year" Header="{x:Static res:Strings.ColumnYear}" Binding="{Binding Track.Year}" IsVisible="{Binding IsYearColumnVisible}" />
        </DataGrid.Columns>
    </DataGrid>

</UserControl>
